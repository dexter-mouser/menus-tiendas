# Puerto del servidor
PUERTO=3000

# Cliente activo: nombre del archivo en config/clientes/ (sin .js)
CLIENTE=la-terraza

# Ruta del archivo SQLite
BASE_DATOS=datos/mesaqr.db

# Usuario administrador que se crea la primera vez
ADMIN_CORREO=
ADMIN_CLAVE=

# Dirección pública para los QR (por ejemplo https://menu.mirestaurante.com).
# Si se deja vacía, se usa la dirección con la que se abre el panel.
URL_PUBLICA=
